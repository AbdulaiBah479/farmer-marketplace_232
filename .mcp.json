        "QDRANT_API_KEY": "YOUR_QDRANT_API_KEY_HERE"
      }
    },
    "neon": {
      "command": "npx",
      "args": ["-y", "mcp-server-neon"],
      "env": {
        "NEON_API_KEY": "YOUR_NEON_API_KEY_HERE"
